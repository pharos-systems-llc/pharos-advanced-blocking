---
import '../styles/global.css';

interface Props {
  title?: string;
  frontmatter?: {
    title?: string;
    heading?: string;
    description?: string;
  };
  headings?: { depth: number; slug: string; text: string }[];
}

const { title, frontmatter, headings } = Astro.props;
const pageTitle = title || frontmatter?.title || 'Pharos Advanced Blocking';
const isProse = !!frontmatter;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const tocHeadings = (headings ?? []).filter((h) => h.depth === 2);
const showToc = isProse && tocHeadings.length > 6;
const pageHeading = frontmatter?.heading;
const pageDescription = frontmatter?.description;
const metaDescription = pageDescription || 'Pharos Advanced Blocking - Next-generation DNS and IP blocking';
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={metaDescription} />
    <meta name="viewport" content="width=device-width" />

    <!-- Favicons -- full set generated from the Pharos Systems brand mark (Nano Banana 2).
         The previous <link rel="icon" href="/favicon.svg"> pointed at a file that never existed.
         Uses baseUrl (already computed above) rather than a hardcoded string, matching this
         file's own established convention for every other internal link. -->
    <link rel="icon" href={`${baseUrl}/pharos-advanced-blocking/favicon.ico`} sizes="any" />
    <link rel="icon" type="image/png" sizes="16x16" href={`${baseUrl}/pharos-advanced-blocking/favicon-16x16.png`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${baseUrl}/pharos-advanced-blocking/favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="48x48" href={`${baseUrl}/pharos-advanced-blocking/favicon-48x48.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${baseUrl}/pharos-advanced-blocking/apple-touch-icon.png`} />
    <link rel="apple-touch-icon" sizes="152x152" href={`${baseUrl}/pharos-advanced-blocking/apple-touch-icon-152x152.png`} />
    <link rel="apple-touch-icon" sizes="167x167" href={`${baseUrl}/pharos-advanced-blocking/apple-touch-icon-167x167.png`} />
    <link rel="manifest" href={`${baseUrl}/pharos-advanced-blocking/site.webmanifest`} />
    <meta name="theme-color" content="#0284c7" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
  </head>

  <body class="min-h-screen flex flex-col">
    <nav class="border-b border-secondary-200 dark:border-secondary-800 bg-white/80 dark:bg-secondary-900/80 backdrop-blur-md sticky top-0 z-50">
      <div class="container-custom py-4 flex items-center justify-between">
        <a href={`${baseUrl}/`} class="font-bold text-2xl tracking-tight text-secondary-900 dark:text-white">
          Pharos<span class="text-primary-500">AB</span>
        </a>
        <div class="flex gap-6 items-center">
          <a href={`${baseUrl}/user-guide/`} class="font-medium hover:text-primary-500">User Guide</a>
          <a href={`${baseUrl}/installation/`} class="font-medium hover:text-primary-500">Installation</a>
          <a href={`${baseUrl}/cli-reference/`} class="font-medium hover:text-primary-500">CLI Reference</a>
          <a href="https://github.com/iamrichardd/pharos-advanced-blocking" class="btn btn-primary">GitHub</a>
        </div>
      </div>
    </nav>
    <main class="flex-grow">
      {isProse ? (
        <article class="container-custom py-12 max-w-4xl mx-auto prose dark:prose-invert">
          {pageHeading && <h1 id={pageHeading.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')}>{pageHeading}</h1>}
          {pageDescription && <p>{pageDescription}</p>}
          {pageHeading && <hr />}
          {showToc && (
            <nav class="toc mb-8 p-4 rounded-lg border border-secondary-200 dark:border-secondary-800 bg-secondary-50 dark:bg-secondary-900/50 not-prose">
              <p class="font-semibold text-sm uppercase tracking-wide text-secondary-500 dark:text-secondary-400 mb-2">On this page</p>
              <ul class="space-y-1 text-sm">
                {tocHeadings.map((h) => (
                  <li><a href={`#${h.slug}`} class="hover:text-primary-500">{h.text}</a></li>
                ))}
              </ul>
            </nav>
          )}
          <slot />
        </article>
      ) : (
        <slot />
      )}
    </main>
    <footer class="py-8 border-t border-secondary-200 dark:border-secondary-800 mt-auto text-center text-sm text-secondary-500">
      &copy; {new Date().getFullYear()} <a href="https://iamrichardd.com" class="hover:text-primary-500 underline decoration-dotted">iamrichardd.com</a>. All rights reserved.
    </footer>
  </body>
</html>
